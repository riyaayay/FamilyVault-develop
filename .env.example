# ==============================================================================
# FamilyVault — Master Environment Configuration Template (.env.example)
#
# INSTRUCTIONS FOR THE TEAM:
# 1. Copy this file to `.env` in your local environment:
#      cp .env.example .env
# 2. Fill in the values from the shared credentials document pinned in Slack.
# 3. NEVER commit `.env` or actual secret values to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL & SUPABASE (Backend Core — Runeet)
# ------------------------------------------------------------------------------
PROJECT_NAME="FamilyVault Core API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://familyvault.vercel.app"

# Supabase connection string (or local postgresql+asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Supabase API Keys & Auth Secret
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ------------------------------------------------------------------------------
# 2. NEO4J AURADB (Graph Service — Riya)
# ------------------------------------------------------------------------------
NEO4J_URI="neo4j+s://your-instance-id.databases.neo4j.io"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-auradb-generated-password"
NEO4J_DATABASE="neo4j"
GRAPH_SERVICE_PORT=8001

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 & BIOMETRICS (Media Service — Ayushman)
# ------------------------------------------------------------------------------
R2_BUCKET_NAME="familyvault-media"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
R2_PUBLIC_DOMAIN="https://media.familyvault.app"

# Standardized Biometric Threshold (Shared with Ayush for tests)
MATCH_THRESHOLD=0.85
EMBEDDING_DIMENSION=512
BIOMETRICS_SERVICE_PORT=8002

# ------------------------------------------------------------------------------
# 4. FRONTEND NEXT.JS (Client App — Raghuvendra & Anushka)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
NEXT_PUBLIC_BACKEND_API_URL="http://localhost:8000"
NEXT_PUBLIC_GRAPH_API_URL="http://localhost:8001"
NEXT_PUBLIC_BIOMETRICS_API_URL="http://localhost:8002"
