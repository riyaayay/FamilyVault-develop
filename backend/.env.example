# ==============================================================================
# FamilyVault Backend Environment Configuration
# NEVER commit the active .env file to git!
# ==============================================================================

# Application Environment
PROJECT_NAME="FamilyVault Core API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (Allowed origins separated by comma)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://familyvault.vercel.app"

# Database Configuration (Supabase PostgreSQL or local asyncpg)
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:54322/postgres"

# Supabase Platform Keys
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Cloudflare R2 Media Storage
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="familyvault-media"
R2_PUBLIC_DOMAIN="https://media.familyvault.app"

# Shared Biometric Match Constant
MATCH_THRESHOLD=0.85
